# Copy to .env and fill in. `.env` is git-ignored and never enters the image.

# --- database (Compose runs Postgres for you) ---
# Hex only, so it is safe inside the connection URL:  openssl rand -hex 24
POSTGRES_PASSWORD=

# --- Mailgun ---
MAILGUN_API_KEY=
MAILGUN_DOMAIN=
# Optional: MAILGUN_FROM="Catasterism Alerts <alerts@your-domain>"
# Optional: MAILGUN_API_BASE_URL=https://api.eu.mailgun.net

# --- companion ---
COMPANION_ALERT_EMAIL=
EXPLORER_URL=https://explorer.catasterism.xyz

# --- public site / proxy ---
# Host name Apache answers to. Any other Host header gets a 403.
SERVER_NAME=localhost
# Public base URL, used by Loco for links.
PUBLIC_URL=http://localhost:8080
# 127.0.0.1 keeps the proxy private to this machine; use 0.0.0.0 in production.
BIND_ADDR=127.0.0.1
HTTP_PORT=8080
